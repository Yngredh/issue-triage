# Copie para `.env` (nunca commite o `.env`). O compose lê este arquivo só para as variáveis
# abaixo; as demais variáveis de cada serviço vêm do `Settings` dele (valores padrão).

# --- Já definidas pelo compose (não preencha; valores de exemplo, só uso local) ---
# DATABASE_URL (issue-analyst-api)=postgresql://analyst_api:analyst_api@postgres:5432/issue_maintenance
# DATABASE_URL (issue-triage)=postgresql://triage_svc:triage_svc@postgres:5432/issue_maintenance
# DATABASE_URL (issue-publisher)=postgresql://publisher_svc:publisher_svc@postgres:5432/issue_maintenance
# RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
# HTTP_PORT=8000
# CATALOG_SOURCE_DIR=/app/catalog/source

# --- Você preenche (segredos: nunca vão para o repositório, o banco nem o log) ---
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# --- Portas do host (opcional; os padrões não colidem com os containers mechanical-hub-*) ---
POSTGRES_PORT=5433
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
ANALYST_API_PORT=8081

# --- Worker e scripts fora do container (docker-compose.dev.yml; exemplos) ---
# Lidas pelo `Settings` do issue-triage, por scripts/evaluate.py e por scripts/send_analysis.py.
# Para o ambiente integrado, use o usuário `postgres` e as portas do host acima.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/issue_triage
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
